<!DOCTYPE html>
<html>

<head>
<title> Vowel Count </title>
</head>

<body align="center">

<form name="PForm">

Enter a String :  <input type="text" id="string" name="t1" placeholder="Input">
<br><br>
<input type="button" name="CheckButton" value="Count Vowels." onClick="cntVow()">
</form>

</body>

<script type="text/javascript">
function cntVow()
{
var str, i, character, counter;
counter = 0;
str = PForm.t1.value;
for(i=0; i<=str.length; i++)
{
character = str.charAt(i);
if (character=="A"|| character=="a"|| character=="E"|| character=="e"|| character=="I"|| character=="i"|| character=="O"|| character=="o"|| character=="U"|| character=="u")
counter++;

}
alert("Number of Vowels = " + counter);

}
</script>
</html>
